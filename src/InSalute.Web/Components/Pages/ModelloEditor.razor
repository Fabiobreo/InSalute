@using InSalute.Core.Domain
@using InSalute.Core.Settings
@using InSalute.Web.Components.Shared
@inject EmailTemplateService Templates
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudGrid>
    <MudItem xs="12" md="6">
        <MudTextField T="string" Value="State.Subject" ValueChanged="OnSubjectChanged" Label="Oggetto" Immediate="true" MaxLength="200"
                      Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField T="string" Value="State.Body" ValueChanged="OnBodyChanged" Label="Corpo" Lines="9" Immediate="true"
                      Variant="Variant.Outlined"
                      UserAttributes="@(new Dictionary<string, object> { ["id"] = BodyId })" />

        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-1">Segnaposto disponibili</MudText>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var placeholder in EmailTemplateService.PlaceholdersFor(State.Kind))
            {
                <MudChip T="string" Icon="@Icons.Material.Filled.Add" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                         OnClick="@(() => InsertAsync(placeholder))" aria-label="@($"Inserisci {placeholder}")" Class="ma-0">@placeholder</MudChip>
            }
        </div>

        @* Gli errori del modello si vedono mentre si scrive, non solo al salvataggio. *@
        @if (LiveError is { } liveError)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">@liveError</MudAlert>
        }
        else if (State.Error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-4">@State.Error</MudAlert>
        }

        <div class="d-flex flex-wrap align-center gap-3 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="State.Saving">Salva modello</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RestoreDefaultAsync" Disabled="IsDefault">Ripristina testo predefinito</MudButton>
            @if (State.IsDirty)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning">Modifiche non salvate</MudText>
            }
        </div>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudText Typo="Typo.subtitle2" Class="mb-1">Anteprima</MudText>
        <EmailAnteprima Subject="@Preview.Subject" Body="@Preview.Body" />
        <MudText Typo="Typo.caption" Class="mt-1">
            Dati di esempio: @EmailTemplateService.SampleFirstName @EmailTemplateService.SampleLastName@(State.Kind == EmailTemplateKind.Password ? $", password {EmailTemplateService.SamplePassword}" : "").
        </MudText>
    </MudItem>
</MudGrid>

@code {
    public sealed class EditorState(EmailTemplateKind kind)
    {
        public EmailTemplateKind Kind { get; } = kind;

        public string Subject { get; set; } = "";

        public string Body { get; set; } = "";

        /// <summary>Testi com'erano all'ultimo caricamento o salvataggio.</summary>
        public string SavedSubject { get; set; } = "";

        public string SavedBody { get; set; } = "";

        public bool IsDirty => Subject != SavedSubject || Body != SavedBody;

        public string? Error { get; set; }

        public bool Saving { get; set; }

        public void MarkSaved()
        {
            SavedSubject = Subject;
            SavedBody = Body;
        }
    }

    [Parameter, EditorRequired]
    public EditorState State { get; set; } = default!;

    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = "";

    /// <summary>Il testo è cambiato o è stato salvato (serve al genitore per l'indicatore sulla scheda).</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string BodyId => $"modello-{IdPrefix}-corpo";

    private (string Subject, string Body) Preview => EmailTemplateService.Preview(State.Subject, State.Body);

    private string? LiveError => EmailTemplateService.Validate(State.Kind, State.Subject, State.Body);

    private bool IsDefault => (State.Subject, State.Body) == EmailTemplateDefaults.For(State.Kind);

    private Task OnSubjectChanged(string value)
    {
        State.Subject = value;
        return OnChanged.InvokeAsync();
    }

    private Task OnBodyChanged(string value)
    {
        State.Body = value;
        return OnChanged.InvokeAsync();
    }

    private async Task InsertAsync(string placeholder)
    {
        try
        {
            await JS.InvokeVoidAsync("inSalute.insertAtCursor", BodyId, placeholder);
        }
        catch (JSException)
        {
            await OnBodyChanged(State.Body + placeholder);
        }
    }

    /// <summary>Rimette i testi predefiniti nel form: diventano effettivi solo con "Salva modello".</summary>
    private Task RestoreDefaultAsync()
    {
        (State.Subject, State.Body) = EmailTemplateDefaults.For(State.Kind);
        State.Error = null;
        return OnChanged.InvokeAsync();
    }

    private async Task SaveAsync()
    {
        State.Error = null;
        State.Saving = true;
        var result = await Templates.SaveAsync(State.Kind, State.Subject, State.Body);
        State.Saving = false;

        if (result.Succeeded)
        {
            // Il servizio salva i testi senza spazi iniziali e finali.
            State.Subject = State.Subject.Trim();
            State.Body = State.Body.Trim();
            State.MarkSaved();
            Snackbar.Add("Modello salvato.", Severity.Success);
        }
        else
        {
            State.Error = result.Error;
        }
        await OnChanged.InvokeAsync();
    }
}
