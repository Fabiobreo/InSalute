@inject IJSRuntime JS
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">Comunica questa password all'utente. Al primo accesso dovrà cambiarla.</MudText>
        <MudPaper Outlined="true" Class="pa-4 d-flex align-center justify-space-between">
            <MudText Typo="Typo.h5" Style="font-family: monospace; letter-spacing: 0.05em;">@Password</MudText>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyAsync">Copia</MudButton>
        </MudPaper>
        <MudText Typo="Typo.body2" Class="mt-4">Questa password viene mostrata una sola volta.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">Chiudi</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter, EditorRequired]
    public string Password { get; set; } = "";

    private async Task CopyAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Password);
            Snackbar.Add("Password copiata.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Impossibile copiare: seleziona la password e copiala a mano.", Severity.Warning);
        }
    }

    private void Close() => MudDialog.Close();
}
