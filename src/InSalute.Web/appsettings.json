{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:/InSaluteData/logs/insalute-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "Storage": {
    "TempPath": "C:\\InSaluteData\\tmp"
  },
  "Retention": {
    "DispatchYears": null
  },
  "AllowedHosts": "*"
}
