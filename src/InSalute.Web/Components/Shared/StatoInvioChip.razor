@using InSalute.Core.Dispatching

@* Il testo dice lo stato; il colore lo conferma (mai solo colore). *@
<StatoBadge Tone="Tone">@Status.Label()</StatoBadge>

@code {
    [Parameter, EditorRequired]
    public DispatchOverallStatus Status { get; set; }

    private StatoBadge.Tono Tone => Status switch
    {
        DispatchOverallStatus.Completed => StatoBadge.Tono.Successo,
        DispatchOverallStatus.PasswordNotSent => StatoBadge.Tono.Avviso,
        DispatchOverallStatus.NotSent => StatoBadge.Tono.Errore,
        _ => StatoBadge.Tono.Neutro,
    };
}
