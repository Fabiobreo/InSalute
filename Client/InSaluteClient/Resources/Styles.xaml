                                                <Setter Property="Background" Value="{DynamicResource ThemeMainLighterColor2}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=ButtonShape, Path=IsFocused}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeMainLighterColor2}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Resources>
                                <ContentPresenter.Content>
                                    <Viewbox Margin="-4 -5 0 0" Width="14" Height="14">
                                        <Path x:Name="ArrowPath" Fill="White" Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
