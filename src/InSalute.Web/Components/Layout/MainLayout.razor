@inherits LayoutComponentBase
@using InSalute.Web.Services
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Apri o chiudi il menu" title="Menu" OnClick="ToggleDrawer" />
        <img src="img/logo.png" alt="" height="32" class="mx-2" />
        <MudText Typo="Typo.h6">InSalute</MudText>
        <MudSpacer />
        <AuthorizeView>
            <MudMenu Label="@(context.User.FindFirst(AppClaims.DisplayName)?.Value ?? context.User.Identity?.Name)" Color="Color.Inherit" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                <MudMenuItem Href="profilo">Profilo</MudMenuItem>
                <MudMenuItem OnClick="LogoutAsync">Esci</MudMenuItem>
            </MudMenu>
            <form id="logout-form" action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="" />
            </form>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
            @Body
        </MudContainer>
        <MudText Typo="Typo.caption" Align="Align.Center" Class="my-4">
            © @DateTime.Now.Year Poliambulatorio InSalute
        </MudText>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica la pagina</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#3375B0",
            Secondary = "#6CBCCE",
            Background = "#FAFAFA",
            Surface = "#FFFFFF",
            Success = "#2E7D32",
            Warning = "#ED6C02",
            Error = "#C62828",
            TextSecondary = "#5F6B76"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "sans-serif"] }
        }
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync() => await JS.InvokeVoidAsync("inSalute.submitForm", "logout-form");
}
