@inherits LayoutComponentBase
@using InSalute.Web.Services
@inject IJSRuntime JS

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="app-bar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       aria-label="Apri o chiudi il menu" title="Menu" OnClick="ToggleDrawer" />
        <img src="img/logo.png" alt="" height="32" class="mx-2" />
        <MudText Typo="Typo.h6" Class="app-title">InSalute</MudText>
        <MudSpacer />
        <AuthorizeView>
            @{
                var displayName = context.User.FindFirst(AppClaims.DisplayName)?.Value ?? context.User.Identity?.Name ?? "";
            }
            @* Con un attivatore personalizzato MudBlazor 9 non apre il menu da solo: è il pulsante che lo apre e lo chiude. *@
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <ActivatorContent Context="menu">
                    <button type="button" class="user-menu" aria-haspopup="menu" aria-label="@($"Menu utente: {displayName}")"
                            @onclick="e => menu.ToggleAsync(e)">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">@Initials(displayName)</MudAvatar>
                        <span class="user-menu-name">@displayName</span>
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" aria-hidden="true" />
                    </button>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Href="profilo" Icon="@Icons.Material.Outlined.Person">Profilo</MudMenuItem>
                    <MudMenuItem OnClick="LogoutAsync" Icon="@Icons.Material.Outlined.Logout">Esci</MudMenuItem>
                </ChildContent>
            </MudMenu>
            <form id="logout-form" action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="" />
            </form>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="main-content">
        @* Contenuto allineato e con la stessa larghezza massima in tutte le pagine. *@
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6 main-content-body">
            @Body
        </MudContainer>
        <AppFooter />
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Si è verificato un errore imprevisto.
    <a href="." class="reload">Ricarica la pagina</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            // Gli stessi colori del sito del poliambulatorio: blu per le azioni, verde come accento.
            Primary = "#3375B0",
            Secondary = "#00A87E",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2A33",
            DrawerBackground = "#FFFFFF",
            Background = "#FAFAFA",
            Surface = "#FFFFFF",
            Success = "#2E7D32",
            Warning = "#ED6C02",
            Error = "#C62828",
            TextSecondary = "#5F6B76"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px", DrawerWidthLeft = "260px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Roboto", "sans-serif"] },
            // In italiano il maiuscolo pesa e si legge peggio: pulsanti e schede con la sola iniziale maiuscola.
            Button = new ButtonTypography { TextTransform = "none", FontWeight = "500" }
        }
    };

    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task LogoutAsync() => await JS.InvokeVoidAsync("inSalute.submitForm", "logout-form");
}
