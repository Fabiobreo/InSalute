@using InSalute.Core.Dispatching

@* Il testo dice lo stato; il colore lo conferma (mai solo colore). *@
<MudChip T="string" Size="Size.Small" Color="ChipColor" Variant="Variant.Filled" Class="ma-0">@Status.Label()</MudChip>

@code {
    [Parameter, EditorRequired]
    public DispatchOverallStatus Status { get; set; }

    private Color ChipColor => Status switch
    {
        DispatchOverallStatus.Completed => Color.Success,
        DispatchOverallStatus.PasswordNotSent => Color.Warning,
        DispatchOverallStatus.NotSent => Color.Error,
        _ => Color.Default,
    };
}
