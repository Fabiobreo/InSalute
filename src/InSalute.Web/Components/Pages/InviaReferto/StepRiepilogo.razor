@using InSalute.Core.Dispatching
@using InSalute.Core.Domain
@using InSalute.Web.Services
@inject DispatchService Dispatcher

<div class="d-flex flex-column gap-4">
    <MudText Typo="Typo.h6" HtmlTag="h2">Riepilogo</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" aria-label="Caricamento del riepilogo" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
    else if (_preview is { } preview)
    {
        <section aria-labelledby="titolo-destinatario">
            <MudText Typo="Typo.body2" id="titolo-destinatario">Destinatario</MudText>
            <MudText Typo="Typo.h5">@Draft.FirstName.Trim() @Draft.LastName.Trim(), @Draft.Email.Trim()</MudText>
        </section>

        <section aria-labelledby="titolo-documenti">
            <MudText Typo="Typo.subtitle1" id="titolo-documenti">Documenti</MudText>
            <ul>
                @foreach (var report in Draft.AcceptedReports)
                {
                    <li>@report.Name</li>
                }
            </ul>
            <MudText Typo="Typo.body2">Il paziente riceverà il file <strong>@preview.ProtectedFileName</strong>.</MudText>
            @if (Draft.Invoice is { IsAccepted: true } invoice)
            {
                <MudText Typo="Typo.body2" Class="mt-2">Fattura: @invoice.Name, allegata senza password.</MudText>
            }
            <MudText Typo="Typo.body2" Class="mt-2">
                @(preview.ProtectionKind == ProtectionKind.PdfAes
                    ? "I documenti saranno uniti in un unico PDF protetto da password."
                    : "I documenti saranno inseriti in un archivio ZIP protetto da password.")
            </MudText>
        </section>

        <section aria-labelledby="titolo-email">
            <MudText Typo="Typo.subtitle1" id="titolo-email" Class="mb-2">Le due email che riceverà il paziente</MudText>
            <MudPaper Outlined="true" Class="pa-3 mb-3">
                <MudText Typo="Typo.caption">1. Email con il referto</MudText>
                <MudText Typo="Typo.subtitle2">@preview.ReportSubject</MudText>
                <pre class="email-preview">@preview.ReportBody</pre>
            </MudPaper>
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.caption">2. Email con la password (inviata solo dopo la prima)</MudText>
                <MudText Typo="Typo.subtitle2">@preview.PasswordSubject</MudText>
                <pre class="email-preview">@preview.PasswordBody</pre>
            </MudPaper>
        </section>

        <MudCheckBox T="bool" @bind-Value="_confirmed" Label="Ho verificato che destinatario e documenti sono corretti." />
    }

    <div class="d-flex justify-space-between mt-2">
        <MudButton Variant="Variant.Outlined" OnClick="OnBack" Disabled="_sending">Indietro</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSend)" OnClick="SendAsync">Invia referto</MudButton>
    </div>
</div>

@code {
    private DispatchPreview? _preview;
    private string? _error;
    private bool _loading = true;
    private bool _confirmed;
    private bool _sending;

    [Parameter, EditorRequired]
    public DispatchDraft Draft { get; set; } = default!;

    /// <summary>Falso se le impostazioni SMTP non sono configurate.</summary>
    [Parameter]
    public bool SendEnabled { get; set; } = true;

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback OnSend { get; set; }

    private bool CanSend => _preview is not null && _confirmed && SendEnabled && !_sending;

    protected override async Task OnInitializedAsync()
    {
        var result = await Dispatcher.PreviewAsync(
            Draft.FirstName, Draft.LastName, Draft.AcceptedReports.Select(r => r.Name).ToList());
        _preview = result.Value;
        _error = result.Succeeded ? null : result.Error;
        _loading = false;
    }

    private async Task SendAsync()
    {
        // Subito disabilitato: niente doppi invii.
        _sending = true;
        await OnSend.InvokeAsync();
    }
}
